{
  "$id": "https://triad.origin.v7/contracts/triad.risk_reservation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_manifest_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_commit": {
      "minLength": 1,
      "type": "string"
    },
    "config_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "emitted_at_us": {
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "RESERVATION"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "account_id": {
          "type": "string"
        },
        "canonical_instrument_id": {
          "type": "string"
        },
        "expiry_us": {
          "type": "integer"
        },
        "linked_execution_ids": {
          "type": "array"
        },
        "owner": {
          "type": "string"
        },
        "reservation_id": {
          "type": "string"
        },
        "reserved_amount": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "reserved_unit": {
          "type": "string"
        },
        "risk_cell": {
          "type": "string"
        },
        "risk_decision_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "REQUESTED",
            "HELD",
            "COMMITTED",
            "RELEASED",
            "EXPIRED",
            "REVOKED"
          ],
          "type": "string"
        }
      },
      "required": [
        "reservation_id",
        "risk_decision_id",
        "account_id",
        "risk_cell",
        "canonical_instrument_id",
        "reserved_amount",
        "reserved_unit",
        "state",
        "expiry_us",
        "owner",
        "linked_execution_ids"
      ],
      "type": "object"
    },
    "producer_epoch": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "producer_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_service": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "triad.risk_reservation.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "build_commit",
    "config_bundle_sha256",
    "contract_manifest_sha256",
    "emitted_at_us",
    "event_id",
    "event_kind",
    "payload",
    "producer_epoch",
    "producer_instance_id",
    "producer_service",
    "schema",
    "schema_version"
  ],
  "title": "triad.risk_reservation.v1",
  "type": "object"
}
