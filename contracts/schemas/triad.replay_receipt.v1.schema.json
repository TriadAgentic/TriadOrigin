{
  "$id": "https://triad.origin.v7/contracts/triad.replay_receipt.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_manifest_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_commit": {
      "minLength": 1,
      "type": "string"
    },
    "config_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "emitted_at_us": {
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "REPLAY_RECEIPT"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "build_commit": {
          "type": "string"
        },
        "checkpoint_identity": {
          "type": "string"
        },
        "config_bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "contract_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "divergence_links": {
          "type": "array"
        },
        "fidelity_class": {
          "type": "string"
        },
        "input_offsets": {
          "type": "array"
        },
        "input_segment_hashes": {
          "type": "array"
        },
        "instrument_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "output_segment_hashes": {
          "type": "array"
        },
        "parameter_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "receipt_id": {
          "type": "string"
        },
        "run_seed": {
          "type": "string"
        },
        "signer": {
          "type": "string"
        },
        "state_checksums": {
          "type": "object"
        },
        "test_suite_result": {
          "type": "object"
        }
      },
      "required": [
        "receipt_id",
        "input_segment_hashes",
        "input_offsets",
        "fidelity_class",
        "build_commit",
        "config_bundle_sha256",
        "contract_manifest_sha256",
        "parameter_digest",
        "instrument_digest",
        "checkpoint_identity",
        "run_seed",
        "platform",
        "output_segment_hashes",
        "state_checksums",
        "test_suite_result",
        "divergence_links",
        "signer"
      ],
      "type": "object"
    },
    "producer_epoch": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "producer_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_service": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "triad.replay_receipt.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "build_commit",
    "config_bundle_sha256",
    "contract_manifest_sha256",
    "emitted_at_us",
    "event_id",
    "event_kind",
    "payload",
    "producer_instance_id",
    "producer_service",
    "schema",
    "schema_version"
  ],
  "title": "triad.replay_receipt.v1",
  "type": "object"
}
