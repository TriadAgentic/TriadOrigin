{
  "$id": "https://triad.origin.v7/contracts/triad.risk_decision.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_manifest_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_commit": {
      "minLength": 1,
      "type": "string"
    },
    "config_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "emitted_at_us": {
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "RISK_DECISION"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "account_id": {
          "type": "string"
        },
        "candidate_id": {
          "type": "string"
        },
        "clause_evaluations": {
          "type": "array"
        },
        "correlation_budget": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "denial_reason": {
          "type": "string"
        },
        "disposition": {
          "enum": [
            "ALLOW",
            "DENY",
            "REDUCE_ONLY"
          ],
          "type": "string"
        },
        "environment": {
          "enum": [
            "LIVE"
          ],
          "type": "string"
        },
        "exposure_snapshot_id": {
          "type": "string"
        },
        "loss_budget": {
          "type": "string"
        },
        "max_leverage": {
          "type": "string"
        },
        "max_notional_quote": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "max_qty_steps": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "protection_requirements": {
          "type": "object"
        },
        "reservation_expiry_us": {
          "type": "integer"
        },
        "reservation_id": {
          "type": "string"
        },
        "risk_cell": {
          "type": "string"
        },
        "risk_decision_id": {
          "type": "string"
        },
        "valid_until_us": {
          "type": "integer"
        }
      },
      "required": [
        "risk_decision_id",
        "decision_id",
        "candidate_id",
        "account_id",
        "risk_cell",
        "environment",
        "disposition",
        "clause_evaluations",
        "exposure_snapshot_id",
        "policy_digest",
        "max_qty_steps",
        "max_notional_quote",
        "max_leverage",
        "loss_budget",
        "correlation_budget",
        "protection_requirements",
        "reservation_id",
        "reservation_expiry_us",
        "valid_until_us",
        "denial_reason"
      ],
      "type": "object"
    },
    "producer_epoch": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "producer_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_service": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "triad.risk_decision.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "build_commit",
    "config_bundle_sha256",
    "contract_manifest_sha256",
    "emitted_at_us",
    "event_id",
    "event_kind",
    "payload",
    "producer_epoch",
    "producer_instance_id",
    "producer_service",
    "schema",
    "schema_version"
  ],
  "title": "triad.risk_decision.v2",
  "type": "object"
}
