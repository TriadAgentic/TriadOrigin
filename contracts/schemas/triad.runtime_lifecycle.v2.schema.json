{
  "$id": "https://triad.origin.v7/contracts/triad.runtime_lifecycle.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "CO-03 step 3: runtime process truth — deployment class, build/config/contract/binding digests, lease{topic, epoch, ttl}, attestation time, plane bindings. deployment_class DARK is the deployment-class vocabulary (closure gate #12), not the retired RC4 connected-dark lever vocabulary. Registered by CO-03 (TRIAD-ORIGIN-V7-CHANGE-ORDERS-2026-08-12) as an additive major. Registration activates no producer and grants no authority; posture unchanged OFF/OFF/OFF/LIVE, DENIED_SAFE_HOLD.",
  "properties": {
    "activation_manifest_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_commit": {
      "minLength": 1,
      "type": "string"
    },
    "config_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "emitted_at_us": {
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "RUNTIME_LIFECYCLE"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "attestation_time": {
          "type": "integer"
        },
        "binding_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "build_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "component_id": {
          "minLength": 1,
          "type": "string"
        },
        "config_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "contract_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "deployment_class": {
          "enum": [
            "ACTIVE_WRITER",
            "REPLICA",
            "MIRROR",
            "DARK",
            "RETIRED"
          ],
          "type": "string"
        },
        "lease": {
          "additionalProperties": false,
          "properties": {
            "epoch": {
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            "topic": {
              "minLength": 1,
              "type": "string"
            },
            "ttl": {
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            }
          },
          "required": [
            "topic",
            "epoch",
            "ttl"
          ],
          "type": "object"
        },
        "plane_bindings": {
          "type": "object"
        }
      },
      "required": [
        "component_id",
        "deployment_class",
        "build_digest",
        "config_digest",
        "contract_digest",
        "binding_digest",
        "lease",
        "attestation_time",
        "plane_bindings"
      ],
      "type": "object"
    },
    "producer_epoch": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "producer_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_service": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "triad.runtime_lifecycle.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "build_commit",
    "config_bundle_sha256",
    "contract_manifest_sha256",
    "emitted_at_us",
    "event_id",
    "event_kind",
    "payload",
    "producer_epoch",
    "producer_instance_id",
    "producer_service",
    "schema",
    "schema_version"
  ],
  "title": "triad.runtime_lifecycle.v2",
  "type": "object"
}
