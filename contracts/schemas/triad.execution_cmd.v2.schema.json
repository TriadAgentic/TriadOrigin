{
  "$id": "https://triad.origin.v7/contracts/triad.execution_cmd.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_manifest_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_commit": {
      "minLength": 1,
      "type": "string"
    },
    "config_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "emitted_at_us": {
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "EXECUTION_CMD"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "account_id": {
          "type": "string"
        },
        "adapter_route": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "authorization_id": {
          "type": "string"
        },
        "canonical_instrument_id": {
          "type": "string"
        },
        "close_position": {
          "type": "boolean"
        },
        "command_id": {
          "type": "string"
        },
        "deadline_us": {
          "type": "integer"
        },
        "expected_prior_order_state": {
          "type": "string"
        },
        "idempotency_id": {
          "type": "string"
        },
        "order_side": {
          "enum": [
            "BUY",
            "SELL"
          ],
          "type": "string"
        },
        "order_type": {
          "type": "string"
        },
        "position_effect": {
          "enum": [
            "OPEN",
            "INCREASE",
            "REDUCE",
            "CLOSE",
            "REVERSE"
          ],
          "type": "string"
        },
        "position_side": {
          "enum": [
            "LONG",
            "SHORT",
            "BOTH"
          ],
          "type": "string"
        },
        "post_only": {
          "type": "boolean"
        },
        "price_protect": {
          "type": "boolean"
        },
        "price_ticks": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "quantity_steps": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "reduce_only": {
          "type": "boolean"
        },
        "reservation_id": {
          "type": "string"
        },
        "retry_budget": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "stp": {
          "type": "string"
        },
        "time_in_force": {
          "type": "string"
        },
        "urgency": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "working_type": {
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "attempt_id",
        "idempotency_id",
        "authorization_id",
        "reservation_id",
        "account_id",
        "canonical_instrument_id",
        "venue",
        "order_side",
        "position_side",
        "position_effect",
        "quantity_steps",
        "price_ticks",
        "order_type",
        "time_in_force",
        "post_only",
        "reduce_only",
        "close_position",
        "working_type",
        "price_protect",
        "stp",
        "role",
        "deadline_us",
        "urgency",
        "retry_budget",
        "adapter_route",
        "expected_prior_order_state"
      ],
      "type": "object"
    },
    "producer_epoch": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "producer_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_service": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "triad.execution_cmd.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "build_commit",
    "config_bundle_sha256",
    "contract_manifest_sha256",
    "emitted_at_us",
    "event_id",
    "event_kind",
    "payload",
    "producer_epoch",
    "producer_instance_id",
    "producer_service",
    "schema",
    "schema_version"
  ],
  "title": "triad.execution_cmd.v2",
  "type": "object"
}
