{
  "$id": "https://triad.origin.v7/contracts/triad.service_heartbeat.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_manifest_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_commit": {
      "minLength": 1,
      "type": "string"
    },
    "config_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "emitted_at_us": {
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "HEARTBEAT"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "lease_state": {
          "type": "string"
        },
        "partition_offsets": {
          "type": "object"
        },
        "quality": {
          "type": "object"
        },
        "service_id": {
          "type": "string"
        },
        "side_effect_capability": {
          "type": "string"
        },
        "warmup_status": {
          "type": "string"
        },
        "watermark": {
          "type": "object"
        }
      },
      "required": [
        "service_id",
        "partition_offsets",
        "watermark",
        "warmup_status",
        "quality",
        "lease_state",
        "side_effect_capability"
      ],
      "type": "object"
    },
    "producer_epoch": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "producer_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_service": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "triad.service_heartbeat.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "build_commit",
    "config_bundle_sha256",
    "contract_manifest_sha256",
    "emitted_at_us",
    "event_id",
    "event_kind",
    "payload",
    "producer_epoch",
    "producer_instance_id",
    "producer_service",
    "schema",
    "schema_version"
  ],
  "title": "triad.service_heartbeat.v1",
  "type": "object"
}
