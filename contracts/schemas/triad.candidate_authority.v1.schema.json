{
  "$id": "https://triad.origin.v7/contracts/triad.candidate_authority.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_manifest_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_commit": {
      "minLength": 1,
      "type": "string"
    },
    "config_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "emitted_at_us": {
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "CANDIDATE_AUTHORITY"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "activation_manifest_id": {
          "type": "string"
        },
        "allocation": {
          "type": "object"
        },
        "authoritative_topic": {
          "type": "string"
        },
        "authority_id": {
          "type": "string"
        },
        "conflicts": {
          "type": "array"
        },
        "epoch": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "expires_at_us": {
          "type": "integer"
        },
        "fencing_token": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "issued_at_us": {
          "type": "integer"
        },
        "issuer": {
          "type": "string"
        },
        "not_before_us": {
          "type": "integer"
        },
        "renewed_at_us": {
          "type": "integer"
        },
        "revoked_at_us": {
          "type": "integer"
        },
        "scope": {
          "type": "object"
        },
        "selected_engine_cohort": {
          "enum": [
            "ORIGIN_CANDIDATE",
            "LEGACY_COMPARATOR"
          ],
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "state": {
          "enum": [
            "ISSUED",
            "ACTIVE",
            "REVOKED",
            "EXPIRED",
            "SUPERSEDED"
          ],
          "type": "string"
        }
      },
      "required": [
        "authority_id",
        "authoritative_topic",
        "scope",
        "selected_engine_cohort",
        "fencing_token",
        "epoch",
        "issued_at_us",
        "not_before_us",
        "expires_at_us",
        "revoked_at_us",
        "renewed_at_us",
        "activation_manifest_id",
        "issuer",
        "state",
        "allocation",
        "conflicts",
        "signature"
      ],
      "type": "object"
    },
    "producer_epoch": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "producer_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_service": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "triad.candidate_authority.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "build_commit",
    "config_bundle_sha256",
    "contract_manifest_sha256",
    "emitted_at_us",
    "event_id",
    "event_kind",
    "payload",
    "producer_instance_id",
    "producer_service",
    "schema",
    "schema_version"
  ],
  "title": "triad.candidate_authority.v1",
  "type": "object"
}
