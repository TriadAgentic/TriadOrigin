{
  "$id": "https://triad.origin.v7/contracts/triad.binding.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_manifest_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_commit": {
      "minLength": 1,
      "type": "string"
    },
    "config_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "emitted_at_us": {
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "BINDING_RECORD"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "activation_scope": {
          "type": "string"
        },
        "binding_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "binding_id": {
          "type": "string"
        },
        "boundary_rule": {
          "type": "string"
        },
        "cardinality": {
          "enum": [
            "EXACTLY_ONE",
            "UNRESOLVED_BLOCKING"
          ],
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "consumer": {
          "type": "string"
        },
        "consuming_wiring_ids": {
          "type": "string"
        },
        "declared_value": {
          "type": "string"
        },
        "disposition_reason": {
          "type": "string"
        },
        "failure_behavior": {
          "type": "string"
        },
        "formula_id": {
          "type": "string"
        },
        "gate": {
          "type": "string"
        },
        "lifecycle_status": {
          "enum": [
            "ACTIVE",
            "BLOCKED"
          ],
          "type": "string"
        },
        "migration_state": {
          "enum": [
            "NOT_APPLICABLE",
            "BLOCKED_NOT_STARTED"
          ],
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "parameter_id": {
          "type": "string"
        },
        "parameter_name": {
          "type": "string"
        },
        "precedence": {
          "type": "string"
        },
        "semantic_slot": {
          "type": "string"
        },
        "source_binding_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "BLOCKED",
            "BLOCKED_BINDING_V2_MIGRATION"
          ],
          "type": "string"
        },
        "superseded_by": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "unit_contract": {
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "semantic_slot",
        "formula_id",
        "parameter_id",
        "parameter_name",
        "declared_value",
        "unit",
        "unit_contract",
        "cardinality",
        "condition",
        "activation_scope",
        "precedence",
        "consumer",
        "consuming_wiring_ids",
        "gate",
        "status",
        "lifecycle_status",
        "migration_state",
        "failure_behavior",
        "boundary_rule",
        "operation_id",
        "source_binding_id",
        "superseded_by",
        "disposition_reason",
        "binding_digest"
      ],
      "type": "object"
    },
    "producer_epoch": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "producer_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_service": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "triad.binding.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "build_commit",
    "config_bundle_sha256",
    "contract_manifest_sha256",
    "emitted_at_us",
    "event_id",
    "event_kind",
    "payload",
    "producer_instance_id",
    "producer_service",
    "schema",
    "schema_version"
  ],
  "title": "triad.binding.v2",
  "type": "object"
}
