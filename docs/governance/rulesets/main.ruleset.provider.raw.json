{
  "id": "DECLARATIVE",
  "name": "main-branch-protection",
  "target": "branch",
  "enforcement": "active",
  "source": "TriadAgentic/TriadOrigin",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks": true,
        "required_status_checks": [
          {
            "context": "CI / test-and-verify"
          }
        ]
      }
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "update"
    }
  ],
  "bypass_actors": [],
  "note": "Declarative snapshot. GitHub rulesets API requires GitHub Pro for private repos. Actual enforcement pending GitHub Pro upgrade or branch protection UI setup.",
  "created_at": "2026-08-10T00:00:00Z",
  "updated_at": "2026-08-10T00:00:00Z"
}
