{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triad.internal/schemas/triad.closure.status.v1.schema.json",
  "title": "TRIAD closure status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "digest", "payload"],
  "properties": {
    "schema": {"const": "triad.closure.status.v1"}, "version": {"const": "1"},
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "canonicalizer", "domain", "preimage_rule", "value"],
      "properties": {"algorithm": {"const": "sha256"}, "canonicalizer": {"const": "triad_origin.canonical.canonical_json"}, "domain": {"const": "triad.closure.status.artifact.v1"}, "preimage_rule": {"const": "canonical_json({domain,schema,version,payload})"}, "value": {"$ref": "#/$defs/sha256"}}
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "program", "semantics_reference", "activation_posture", "cryptographic_authentication", "overall_state", "current_work", "milestones", "open_blockers", "closed_claims", "next_gate"],
      "properties": {
        "classification": {"const": "GENERATED_STATUS_NON_EVIDENCE"}, "program": {"const": "TRIAD_B00_BN_CLOSURE_MARATHON_2026_08_11"},
        "semantics_reference": {
          "type": "object", "additionalProperties": false, "required": ["path", "schema", "digest_domain", "digest_sha256"],
          "properties": {"path": {"const": "docs/control/closure/closure_semantics.v1.json"}, "schema": {"const": "triad.closure.semantics.v1"}, "digest_domain": {"const": "triad.closure.semantics.artifact.v1"}, "digest_sha256": {"$ref": "#/$defs/sha256"}}
        },
        "activation_posture": {"$ref": "#/$defs/activationPosture"}, "cryptographic_authentication": {"const": "NOT_CLAIMED"},
        "overall_state": {"const": "SOURCE_IN_PROGRESS_BLOCKED_SAFE_HOLD"},
        "current_work": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/compositeIdentity"}},
        "milestones": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/statusRow"}},
        "open_blockers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blocker"}},
        "closed_claims": {"type": "array", "maxItems": 0}, "next_gate": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "compositeIdentity": {"type": "string", "pattern": "^(?:CONTROL_FREEZE::C0|ORIGIN_REPAIR::(?:B00R_G2|B01C|B02C|B03C|B04C|B05C|B06R|B07|B08|B09|B10)|ESTATE_CLOSURE::BN)::sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "activationPosture": {
      "type": "object", "additionalProperties": false, "required": ["venue_environment", "venue_activation", "paper_activation", "shadow_activation"],
      "properties": {"venue_environment": {"const": "OFF"}, "venue_activation": {"const": "OFF"}, "paper_activation": {"const": "OFF"}, "shadow_activation": {"const": "LIVE"}}
    },
    "statusRow": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "work_state", "gate_state", "receipt_state", "runtime_state", "blocking_reasons"],
      "properties": {
        "identity": {"$ref": "#/$defs/compositeIdentity"},
        "work_state": {"enum": ["NOT_STARTED", "SOURCE_IN_PROGRESS"]}, "gate_state": {"const": "BLOCKED"},
        "receipt_state": {"const": "BLOCKED"}, "runtime_state": {"enum": ["NOT_APPLICABLE", "NOT_ATTESTED"]},
        "blocking_reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "blocker": {
      "type": "object", "additionalProperties": false, "required": ["blocker_id", "owner_identity", "severity", "status", "reason"],
      "properties": {"blocker_id": {"type": "string", "minLength": 1}, "owner_identity": {"$ref": "#/$defs/compositeIdentity"}, "severity": {"enum": ["P0", "P1"]}, "status": {"const": "OPEN"}, "reason": {"type": "string", "minLength": 1}}
    }
  }
}
