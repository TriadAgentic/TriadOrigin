            "row_count": {
              "const": 1250
            },
            "source_commit": {
              "const": "b641edcf7e921e93030f681ae3e6339933f2bcc8"
            }
          },
          "required": [
            "path",
            "byte_sha256",
            "ledger_version",
            "row_count",
            "source_commit"
          ],
          "type": "object"
        },
        "rows": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "legacy_milestone": {
                "minLength": 1,
                "type": "string"
              },
              "legacy_review_row_digest": {
                "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
                "type": "string"
              },
              "legacy_task_id": {
                "minLength": 1,
                "type": "string"
              },
              "review_subject_row_digest": {
                "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
                "type": "string"
              },
              "source_review_state": {
                "enum": [
                  "CHANGED_REVIEW_REQUIRED",
                  "UNCHANGED_SINCE_REVIEW_SUBJECT"
                ]
              },
              "source_row_digest": {
                "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
                "type": "string"
              },
              "target": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "CURRENT_COMPOSITE_MILESTONE"
                      },
                      "milestone_identity": {
                        "pattern": "^(?:ORIGIN_REPAIR::(?:B01C|B02C|B03C|B04C|B05C|B06R|B07|B08|B09)|ESTATE_CROSS_REPO::XC01)::sha256:(?!0{64}$)[0-9a-f]{64}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "milestone_identity"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "consumer_milestone_identities": {
                        "items": {
                          "pattern": "^(?:ORIGIN_REPAIR::(?:B01C|B02C|B03C|B04C|B05C|B06R|B07|B08|B09)|ESTATE_CROSS_REPO::XC01)::sha256:(?!0{64}$)[0-9a-f]{64}$",
                          "type": "string"
                        },
                        "maxItems": 1,
                        "type": "array",
                        "uniqueItems": true
                      },
                      "formula_id": {
                        "pattern": "^F(?:0[0-9]|1[0-9]|2[0-3])$",
                        "type": "string"
                      },
                      "implementation_milestone_identity": {
                        "pattern": "^(?:ORIGIN_REPAIR::(?:B01C|B02C|B03C|B04C|B05C|B06R|B07|B08|B09)|ESTATE_CROSS_REPO::XC01)::sha256:(?!0{64}$)[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "kind": {
                        "const": "FORMULA_IMPLEMENTATION"
                      },
                      "owner_engine": {
                        "const": "E02"
                      }
                    },
                    "required": [
                      "kind",
                      "formula_id",
                      "owner_engine",
                      "implementation_milestone_identity",
                      "consumer_milestone_identities"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "attestation_state": {
                        "const": "NOT_ATTESTED"
                      },
                      "conformance_milestone_identity": {
                        "pattern": "^(?:ORIGIN_REPAIR::(?:B01C|B02C|B03C|B04C|B05C|B06R|B07|B08|B09)|ESTATE_CROSS_REPO::XC01)::sha256:(?!0{64}$)[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "formula_id": {
                        "pattern": "^F(?:01|07|20|21|22|23)$",
                        "type": "string"
                      },
                      "kind": {
                        "const": "FORMULA_EXTERNAL_OWNER_RECEIPT"
                      },
                      "owner_engine": {
                        "enum": [
                          "E01",
                          "E08",
                          "E09",
                          "E10"
                        ]
                      },
                      "owner_receipt_slot_id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "provider_binding_state": {
                        "const": "UNBOUND"
                      },
                      "receipt_milestone_identity": {
                        "pattern": "^(?:ORIGIN_REPAIR::(?:B01C|B02C|B03C|B04C|B05C|B06R|B07|B08|B09)|ESTATE_CROSS_REPO::XC01)::sha256:(?!0{64}$)[0-9a-f]{64}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "formula_id",
                      "owner_engine",
                      "owner_receipt_slot_id",
                      "receipt_milestone_identity",
                      "conformance_milestone_identity",
                      "provider_binding_state",
                      "attestation_state"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "EXTERNAL_OBLIGATION"
                      },
                      "owner_binding_state": {
                        "const": "UNBOUND"
                      },
                      "owner_lane": {
                        "enum": [
                          "ESTATE",
                          "OPERATOR"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "owner_lane",
                      "owner_binding_state"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "future_track": {
                        "const": "FUTURE_EXPANSION"
                      },
                      "kind": {
                        "const": "FUTURE_EXPANSION"
                      }
                    },
                    "required": [
                      "kind",
                      "future_track"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "disposition_id": {
                        "const": "LEGACY_B00_REALLOCATION_REQUIRED"
                      },
                      "kind": {
                        "const": "BLOCKING_DISPOSITION"
                      }
                    },
                    "required": [
                      "kind",
                      "disposition_id"
                    ],
                    "type": "object"
                  }
                ]
              },
              "target_allocation_review_state": {
                "const": "UNBOUND"
              }
            },
            "required": [
              "legacy_task_id",
              "legacy_milestone",
              "source_row_digest",
              "review_subject_row_digest",
              "legacy_review_row_digest",
              "source_review_state",
              "target_allocation_review_state",
              "target"
            ],
            "type": "object"
          },
          "maxItems": 1250,
          "minItems": 1250,
          "type": "array"
        },
        "source_ledger": {
          "additionalProperties": false,
          "properties": {
            "byte_sha256": {
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
              "type": "string"
            },
            "ledger_version": {
              "const": "CANDIDATE_V3"
            },
            "path": {
              "const": "docs/control/build_ledger.json"
            },
            "row_count": {
              "const": 1250
            }
          },
          "required": [
            "path",
            "byte_sha256",
            "ledger_version",
            "row_count"
          ],
          "type": "object"
        }
      },
      "required": [
        "allocation_summary",
        "blocking_dispositions",
        "classification",
        "legacy_review_artifact",
        "mapping_law",
        "program",
        "review_coverage",
        "review_subject_ledger",
        "rows",
        "source_ledger"
      ],
      "type": "object"
    },
    "schema": {
      "const": "triad.closure.task_binding.v1"
    },
    "version": {
      "const": "1"
    }
  },
  "required": [
    "schema",
    "version",
    "digest",
    "payload"
  ],
  "type": "object"
}
