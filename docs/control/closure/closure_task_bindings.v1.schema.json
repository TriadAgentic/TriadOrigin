{
  "$id": "https://triad.invalid/schemas/closure-task-binding-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalizer": {
          "const": "triad_origin.canonical.canonical_json"
        },
        "domain": {
          "const": "triad.closure.task_binding.artifact.v1"
        },
        "preimage_rule": {
          "const": "canonical_json({domain,schema,version,payload})"
        },
        "value": {
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "canonicalizer",
        "domain",
        "preimage_rule",
        "value"
      ],
      "type": "object"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "allocation_summary": {
          "additionalProperties": false,
          "properties": {
            "classified_target_task_count": {
              "const": 1153
            },
            "external_formula_receipt_task_count": {
              "const": 42
            },
            "external_obligation_task_count": {
              "const": 418
            },
            "target_allocation_review_state": {
              "const": "UNBOUND"
            },
            "unallocated_task_count": {
              "const": 97
            },
            "unallocated_task_ids_sha256": {
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "classified_target_task_count",
            "external_formula_receipt_task_count",
            "external_obligation_task_count",
            "target_allocation_review_state",
            "unallocated_task_count",
            "unallocated_task_ids_sha256"
          ],
          "type": "object"
        },
        "blocking_dispositions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "disposition_id": {
                "enum": [
                  "C0-CURRENT-LEDGER-REVIEW",
                  "C0-TARGET-ALLOCATION-REVIEW",
                  "LEGACY_B00_REALLOCATION_REQUIRED"
                ]
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "severity": {
                "const": "P0"
              },
              "status": {
                "const": "OPEN"
              }
            },
            "required": [
              "disposition_id",
              "severity",
              "status",
              "reason"
            ],
            "type": "object"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "classification": {
          "const": "NORMATIVE_TASK_BINDING_SAFE_HOLD"
        },
        "legacy_review_artifact": {
          "additionalProperties": false,
          "properties": {
            "byte_sha256": {
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
              "type": "string"
            },
            "classification": {
              "const": "HISTORICAL_ONLY"
            },
            "path": {
              "const": "docs/control/build_ledger_review.v1.json"
            },
            "review_version": {
              "const": "build-ledger-review.v1"
            },
            "reviewed_ledger_version": {
              "const": "REVIEWED_V2"
            },
            "row_count": {
              "const": 1250
            }
          },
          "required": [
            "path",
            "byte_sha256",
            "review_version",
            "reviewed_ledger_version",
            "classification",
            "row_count"
          ],
          "type": "object"
        },
        "mapping_law": {
          "minLength": 1,
          "type": "string"
        },
        "program": {
          "const": "TRIAD_B00_BN_CLOSURE_MARATHON_2026_08_11"
        },
        "review_coverage": {
          "additionalProperties": false,
          "properties": {
            "changed_row_count": {
              "const": 94
            },
            "changed_task_ids_sha256": {
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
              "type": "string"
            },
            "current_ledger_review_state": {
              "const": "UNBOUND"
            },
            "target_allocation_review_state": {
              "const": "UNBOUND"
            },
            "unchanged_row_count": {
              "const": 1156
            }
          },
          "required": [
            "changed_row_count",
            "changed_task_ids_sha256",
            "current_ledger_review_state",
            "target_allocation_review_state",
            "unchanged_row_count"
          ],
          "type": "object"
        },
        "review_subject_ledger": {
          "additionalProperties": false,
          "properties": {
            "byte_sha256": {
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
              "type": "string"
            },
            "ledger_version": {
              "const": "REVIEWED_V2"
            },
            "path": {
              "const": "docs/control/closure/predecessors/build_ledger.REVIEWED_V2.json"
