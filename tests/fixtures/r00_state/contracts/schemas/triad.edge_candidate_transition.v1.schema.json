{
  "$id": "https://triad.origin.v7/contracts/triad.edge_candidate_transition.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_manifest_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_commit": {
      "minLength": 1,
      "type": "string"
    },
    "config_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "emitted_at_us": {
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "CANDIDATE_TRANSITION"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "event_time_us": {
          "type": "integer"
        },
        "from_state": {
          "type": "string"
        },
        "knowledge_at_us": {
          "type": "integer"
        },
        "previous_transition_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source_transition_id": {
          "type": "string"
        },
        "state_seq": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "to_state": {
          "type": "string"
        },
        "transition_id": {
          "type": "string"
        }
      },
      "required": [
        "transition_id",
        "candidate_id",
        "state_seq",
        "previous_transition_id",
        "from_state",
        "to_state",
        "reason",
        "source_transition_id",
        "event_time_us",
        "knowledge_at_us"
      ],
      "type": "object"
    },
    "producer_epoch": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "producer_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_service": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "triad.edge_candidate_transition.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "build_commit",
    "config_bundle_sha256",
    "contract_manifest_sha256",
    "emitted_at_us",
    "event_id",
    "event_kind",
    "payload",
    "producer_epoch",
    "producer_instance_id",
    "producer_service",
    "schema",
    "schema_version"
  ],
  "title": "triad.edge_candidate_transition.v1",
  "type": "object"
}
