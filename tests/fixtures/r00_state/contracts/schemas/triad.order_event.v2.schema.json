{
  "$id": "https://triad.origin.v7/contracts/triad.order_event.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_manifest_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_commit": {
      "minLength": 1,
      "type": "string"
    },
    "config_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "emitted_at_us": {
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "ORDER_EVENT"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "account_id": {
          "type": "string"
        },
        "authorization_id": {
          "type": "string"
        },
        "canonical_instrument_id": {
          "type": "string"
        },
        "command_id": {
          "type": "string"
        },
        "cumulative_qty_steps": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "event_time_us": {
          "type": "integer"
        },
        "idempotency_id": {
          "type": "string"
        },
        "liquidity_intent": {
          "type": "string"
        },
        "oms_order_id": {
          "type": "string"
        },
        "order_family": {
          "enum": [
            "REGULAR",
            "ALGO"
          ],
          "type": "string"
        },
        "order_role": {
          "type": "string"
        },
        "order_side": {
          "enum": [
            "BUY",
            "SELL"
          ],
          "type": "string"
        },
        "order_type": {
          "type": "string"
        },
        "position_effect": {
          "type": "string"
        },
        "position_side": {
          "type": "string"
        },
        "price_ticks": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "qty_steps": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "receipt_time_us": {
          "type": "integer"
        },
        "reconciliation_status": {
          "type": "string"
        },
        "remaining_qty_steps": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "source_payload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "time_in_force": {
          "type": "string"
        },
        "transaction_time_us": {
          "type": "integer"
        },
        "venue_order_id": {
          "type": "string"
        },
        "venue_response": {
          "type": "string"
        }
      },
      "required": [
        "oms_order_id",
        "venue_order_id",
        "command_id",
        "idempotency_id",
        "authorization_id",
        "account_id",
        "canonical_instrument_id",
        "order_side",
        "position_side",
        "position_effect",
        "order_role",
        "liquidity_intent",
        "order_type",
        "time_in_force",
        "price_ticks",
        "qty_steps",
        "cumulative_qty_steps",
        "remaining_qty_steps",
        "state",
        "reason",
        "venue_response",
        "event_time_us",
        "transaction_time_us",
        "receipt_time_us",
        "order_family",
        "reconciliation_status",
        "source_payload_hash"
      ],
      "type": "object"
    },
    "producer_epoch": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "producer_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_service": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "triad.order_event.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "build_commit",
    "config_bundle_sha256",
    "contract_manifest_sha256",
    "emitted_at_us",
    "event_id",
    "event_kind",
    "payload",
    "producer_epoch",
    "producer_instance_id",
    "producer_service",
    "schema",
    "schema_version"
  ],
  "title": "triad.order_event.v2",
  "type": "object"
}
