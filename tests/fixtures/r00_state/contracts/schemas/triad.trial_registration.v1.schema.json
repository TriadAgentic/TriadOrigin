        "demotion_threshold": {
          "type": "string"
        },
        "embargo": {
          "type": "string"
        },
        "entry_model": {
          "type": "string"
        },
        "exit_model": {
          "type": "string"
        },
        "family_id": {
          "type": "string"
        },
        "fill_model": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "frozen_at_us": {
          "type": "integer"
        },
        "hypothesis": {
          "type": "string"
        },
        "multiplicity_family": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "parameters": {
          "type": "string"
        },
        "power_sample_rule": {
          "type": "string"
        },
        "primary_metric": {
          "type": "string"
        },
        "promotion_threshold": {
          "type": "string"
        },
        "purge": {
          "type": "string"
        },
        "regimes": {
          "type": "array"
        },
        "result_access_audit": {
          "type": "string"
        },
        "sample_unit": {
          "type": "string"
        },
        "sides": {
          "type": "array"
