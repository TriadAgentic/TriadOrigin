{
  "$id": "https://triad.origin.v7/contracts/triad.protection_event.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_manifest_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "build_commit": {
      "minLength": 1,
      "type": "string"
    },
    "config_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "emitted_at_us": {
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "PROTECTION_EVENT"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "algo_order_id": {
          "type": "string"
        },
        "authorization_id": {
          "type": "string"
        },
        "covered_qty_steps": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "deadline_us": {
          "type": "integer"
        },
        "position_id": {
          "type": "string"
        },
        "price_protect": {
          "type": "boolean"
        },
        "protection_group_id": {
          "type": "string"
        },
        "raw_evidence": {
          "type": "object"
        },
        "reconciliation": {
          "type": "object"
        },
        "regular_order_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "REQUESTED",
            "ACKNOWLEDGED",
            "ARMED",
            "TRIGGERING",
            "TRIGGERED",
            "FINISHED",
            "REJECTED",
            "EXPIRED",
            "CANCELED",
            "DEGRADED"
          ],
          "type": "string"
        },
        "trigger_price_ticks": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "working_type": {
          "type": "string"
        }
      },
      "required": [
        "protection_group_id",
        "position_id",
        "authorization_id",
        "regular_order_id",
        "algo_order_id",
        "state",
        "trigger_price_ticks",
        "working_type",
        "price_protect",
        "covered_qty_steps",
        "deadline_us",
        "raw_evidence",
        "reconciliation"
      ],
      "type": "object"
    },
    "producer_epoch": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "producer_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer_service": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "triad.protection_event.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "build_commit",
    "config_bundle_sha256",
    "contract_manifest_sha256",
    "emitted_at_us",
    "event_id",
    "event_kind",
    "payload",
    "producer_epoch",
    "producer_instance_id",
    "producer_service",
    "schema",
    "schema_version"
  ],
  "title": "triad.protection_event.v2",
  "type": "object"
}
